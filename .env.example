# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bukshort
POSTGRES_PORT=5432

# Backend Service Configuration
BACKEND_PORT=8080

# Frontend Service Configuration
FRONTEND_PORT=3000

# Public API URL (Set to your Cloudflare Tunnel backend domain)
API_URL=https://api.short.jirapat.tech/

# GitHub Container Registry Owner (For production docker-compose.prod.yml)
GHCR_OWNER=bukharney

# Cloudflare Tunnel Token (Get from Cloudflare Zero Trust Dashboard -> Tunnels)
TUNNEL_TOKEN=eyJh...your_cloudflare_tunnel_token_here...
